override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Local OIDC Connect files
oidc-connect/

# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

